# Code Signing Configuration
# Copy to .env and fill in your values (never commit .env!)

# Windows EV/OV Code Signing Certificate (PFX format)
CERT_FILE=./certs/certificate.pfx
CERT_PASSWORD=your_pfx_password_here
CERT_HASH_ALGO=sha256

# Optional: Timestamp server (default: DigiCert/GlobalSign)
# CERT_TIMESTAMP_SERVER=http://timestamp.digicert.com

# GitHub Publisher (for auto-updates)
GH_TOKEN=your_github_token_here